{
  "name": "intercom-homekit",
  "version": "0.7.0",
  "private": true,
  "description": "HomeKit video doorbell bridge with two-way audio for Hikvision door stations (Home Assistant add-on)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "preversion": "node scripts/version-hook.ts check",
    "version": "node scripts/version-hook.ts apply",
    "postversion": "node scripts/version-hook.ts commit"
  },
  "dependencies": {
    "hap-nodejs": "^0.14.3",
    "koffi": "^3.3.6",
    "opus-decoder": "^0.7.12",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aedes": "^1.2.0",
    "typescript": "5.9"
  }
}
